# Candidate Elimination Algorithm

data = [
    ['Sunny', 'Warm', 'Normal', 'Strong', 'Warm', 'Same', 'Yes'],
    ['Sunny', 'Warm', 'High', 'Strong', 'Warm', 'Same', 'Yes'],
    ['Rainy', 'Cold', 'High', 'Strong', 'Warm', 'Change', 'No'],
    ['Sunny', 'Warm', 'High', 'Strong', 'Cool', 'Change', 'Yes']
]

n = len(data[0]) - 1

S = ['0'] * n
G = [['?'] * n]

for row in data:
    x, target = row[:-1], row[-1]

    if target == 'Yes':
        G = [g for g in G if all(
            g[i] == '?' or g[i] == x[i] for i in range(n)
        )]

        for i in range(n):
            if S[i] == '0':
                S[i] = x[i]
            elif S[i] != x[i]:
                S[i] = '?'
    else:
        new_G = []

        for g in G:
            if all(g[i] == '?' or g[i] == x[i] for i in range(n)):
                for i in range(n):
                    if S[i] != '?' and S[i] != '0' and S[i] != x[i]:
                        h = g.copy()
                        h[i] = S[i]
                        if h not in new_G:
                            new_G.append(h)
            else:
                new_G.append(g)

        G = new_G

print("Specific Boundary (S):", S)
print("General Boundary (G):", G)

